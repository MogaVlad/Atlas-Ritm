# Copy this file to .env.local to turn on the live "Ask Ritm" chat.
# Everything here is optional: with no keys, Ask Ritm answers from built-in replies.
# Keys are read only on the server (app/api/chat/route.ts) and never reach the browser.

# Google Gemini is tried first when its key is set.
GEMINI_API_KEY=
# Optional. Default: gemini-3.1-flash-lite
GEMINI_MODEL=

# Anthropic Claude is used when there's no Gemini key.
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5
ANTHROPIC_MODEL=
